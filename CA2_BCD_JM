.global _start
_start:
.text
main:
    addi     sp, zero, 0x600
	beq  zero, zero, loop_calculadora
	
	loop_calculadora:

		la   a0, msg_num1
		jal  ra, imprimir_cadena

		la   a0, entrada
		jal  ra, leer_numero

		la   a0, entrada
		la   a1, resultado_bcd
		jal  ra, ascii_a_bcd

		la   a0, resultado_bcd
		jal  ra, bcd_to_float
		fmv.s fs0, fa0                # primer operando guardado en fs0

		la   a0, msg_num2
		jal  ra, imprimir_cadena

		la   a0, entrada
		jal  ra, leer_numero

		la   a0, entrada
		la   a1, resultado_bcd
		jal  ra, ascii_a_bcd

		la   a0, resultado_bcd
		jal  ra, bcd_to_float
		fmv.s fs1, fa0 
		
		la   a0, msg_op
		jal  ra, imprimir_cadena

		jal  ra, LeerCaracterUART      # a0 = caracter del operador
		add  t6, a0, zero              # se guarda para comparar despues del eco
		jal  ra, WriteUART             # eco del operador en pantalla

		addi t1, zero, 43              # '+'
		beq  t6, t1, op_suma
		addi t1, zero, 45              # '-'
		beq  t6, t1, op_resta
		addi t1, zero, 42              # '*'
		beq  t6, t1, op_mult
		addi t1, zero, 47              # '/'
		beq  t6, t1, op_div
		beq  zero, zero, op_suma       # operador no reconocido -> suma por defecto

		op_suma:
			fadd.s fa0, fs0, fs1
			beq  zero, zero, op_mostrar
		op_resta:
			fsub.s fa0, fs0, fs1
			beq  zero, zero, op_mostrar
		op_mult:
			fmul.s fa0, fs0, fs1
			beq  zero, zero, op_mostrar
		op_div:
			fdiv.s fa0, fs0, fs1

		op_mostrar:
			la   a1, resultado_bcd
			jal  ra, float_to_bcd          # llena resultado_bcd con el resultado

			la   a0, msg_res
			jal  ra, imprimir_cadena

			la   a0, resultado_bcd
			jal  ra, mostrar_bcd

			la   a0, msg_nl
			jal  ra, imprimir_cadena
			
			beq  zero, zero, loop_calculadora
			
			
	# imprimir_cadena: 
	# a0 = puntero arreglo ascii indicacion
	# ASCII de cada caracter, terminado en 0. Los va sacando por UART.
	imprimir_cadena:
		addi sp, sp, -12
		sw   s0, 8(sp)
		sw   s1, 4(sp)
		sw   ra, 0(sp)

		add  s0, a0, zero

		ip_loop:
			lw   s1, 0(s0)
			beq  s1, zero, ip_fin
			add  a0, s1, zero
			jal  ra, WriteUART
			addi s0, s0, 4
			beq  zero, zero, ip_loop

		ip_fin:
			lw   s0, 8(sp)
			lw   s1, 4(sp)
			lw   ra, 0(sp)
			addi sp, sp, 12
			jr   ra
		
	
	# Acepta digitos 0-9,'-' y '.'
	#ARGS
	# a0: puntero arreglo con la entrada. 
	#RET
	#a0: puntero arreglo donde se guarda la entrada
	
	leer_numero:
		addi sp, sp, -12
		sw   s0, 8(sp)          # cursor de escritura actual
		sw   s1, 4(sp)          
		sw   ra, 0(sp)

		add  s0, a0, zero
		add  s1, a0, zero

		ln_loop:
			jal  ra, LeerCaracterUART

			addi t1, zero, 13
			beq  a0, t1, ln_fin
			addi t1, zero, 10
			beq  a0, t1, ln_fin

			addi t1, zero, 127
			bne  a0, t1, ln_check_digito
			beq  s0, s1, ln_loop        # entrada vacia, nada que borrar
			addi s0, s0, -4
			jal  ra, DELChar
			beq  zero, zero, ln_loop

		ln_check_digito:
			addi t1, zero, 48
			blt  a0, t1, ln_check_signo
			addi t2, zero, 57
			blt  t2, a0, ln_check_signo
			beq  zero, zero, ln_guardar

		ln_check_signo:
			addi t1, zero, 45              # '-'
			beq  a0, t1, ln_guardar
			addi t1, zero, 46              # '.'
			beq  a0, t1, ln_guardar
			beq  zero, zero, ln_loop       # caracter invalido: se ignora, sin eco

		ln_guardar:
			sw   a0, 0(s0)
			addi s0, s0, 4
			jal  ra, WriteUART             # eco del caracter aceptado
			beq  zero, zero, ln_loop

		ln_fin:
			sw   zero, 0(s0)               # terminador

			lw   s0, 8(sp)
			lw   s1, 4(sp)
			lw   ra, 0(sp)
			addi sp, sp, 12
			jr   ra
	

	
	# Acepta digitos 0-9,'-' y '.'
	#ARGS
	#a0: puntero cadena ASCII (salida leer_numero)
	#a1 = puntero arreglo BCD formato general
	#RET
	#a0: puntero arreglo BCD formato general
	
	ascii_a_bcd:
		addi sp, sp, -28
		sw   s0, 24(sp)     # cursor  entrada
		sw   s1, 20(sp)     # base arreglo destino
		sw   s2, 16(sp)     # signo
		sw   s3, 12(sp)     # cantidad de enteros 
		sw   s4,  8(sp)     # slot actual / contador de decimales
		sw   s5,  4(sp)     # inicio de los digitos enteros (para la segunda pasada)
		sw   ra,  0(sp)

		add  s1, a1, zero

		# reset BCD
		addi t0, zero, 0
		az_limpiar:
			addi t1, zero, 17
			beq  t0, t1, az_limpiar_fin
			add  t2, t0, t0
			add  t2, t2, t2
			add  t2, t2, s1
			sw   zero, 0(t2)
			addi t0, t0, 1
			beq  zero, zero, az_limpiar
			
		az_limpiar_fin:
		
		add  s0, a0, zero
		addi s2, zero, 0

		lw   t0, 0(s0)
		addi t1, zero, 45               # '-'
		bne  t0, t1, az_sin_signo
		addi s2, zero, 1
		addi s0, s0, 4
		
		az_sin_signo:
		sw   s2, 0(s1)
		add  s5, s0, zero               # aca empiezan los digitos de la parte entera

		# --- primera pasada: contar cuantos digitos enteros hay ---
		addi s3, zero, 0
		az_contar:
			lw   t0, 0(s0)
			beq  t0, zero, az_contar_fin
			addi t1, zero, 46           # '.'
			beq  t0, t1, az_contar_fin
			addi s3, s3, 1
			addi s0, s0, 4
			beq  zero, zero, az_contar
		az_contar_fin:

		addi t1, zero, 10
		blt  s3, t1, az_sin_recorte
			addi s3, zero, 10           # se recortan a 10 los digitos enteros
		az_sin_recorte:

		# --- segunda pasada: guardar alineado a la derecha (slot 10 = unidades) ---
		add  s0, s5, zero
		addi t3, zero, 11
		sub  s4, t3, s3                 # s4 = slot inicial = 11 - n_int

		az_guardar_ent:
			lw   t0, 0(s0)
			addi t1, zero, 46
			beq  t0, t1, az_ent_fin
			beq  t0, zero, az_ent_fin

			addi t1, zero, 11
			blt  s4, t1, az_ent_guarda
				beq zero, zero, az_ent_salta     # ya se llenaron los 10 slots

			az_ent_guarda:
				add  t2, s4, s4
				add  t2, t2, t2
				add  t2, t2, s1
				addi t4, zero, 48
				sub  t5, t0, t4
				sw   t5, 0(t2)

			az_ent_salta:
				addi s4, s4, 1
				addi s0, s0, 4
				beq  zero, zero, az_guardar_ent

		az_ent_fin:
			addi t2, zero, 44               # offset del slot 11 (11*4)
			add  t2, t2, s1
			addi t5, zero, 46
			sw   t5, 0(t2)                  # marcador de punto, fijo en el slot 11

			lw   t0, 0(s0)
			addi t1, zero, 46
			bne  t0, t1, az_sin_punto
				addi s0, s0, 4               # si habia un punto, lo saltamos
		az_sin_punto:

		# --- parte decimal: se guarda en orden, maximo 5 digitos ---
		addi s4, zero, 0
		az_guardar_frac:
			lw   t0, 0(s0)
			beq  t0, zero, az_frac_fin
			addi t1, zero, 5
			beq  s4, t1, az_frac_fin

			addi t3, zero, 12
			add  t2, s4, t3
			add  t2, t2, t2
			add  t2, t2, t2
			add  t2, t2, s1
			addi t4, zero, 48
			sub  t5, t0, t4
			sw   t5, 0(t2)

			addi s4, s4, 1
			addi s0, s0, 4
			beq  zero, zero, az_guardar_frac
		az_frac_fin:

		lw   s0, 24(sp)
		lw   s1, 20(sp)
		lw   s2, 16(sp)
		lw   s3, 12(sp)
		lw   s4,  8(sp)
		lw   s5,  4(sp)
		lw   ra,  0(sp)
		addi sp, sp, 28
		jr   ra

	#Integra ReadUART para leer en bucle garantizando datos nuevos de forma reutilizable
	#ARGS
	#RET
	#a0: Retorna en a0 el caracter
	LeerCaracterUART:
		addi sp, sp, -4
		sw   ra, 0(sp)

		lc_sondeo:
			jal  ra, ReadUART
			la   t0, OchoMil
			lw   t0, 0(t0)
			and  t0, t0, a0
			beq  t0, zero, lc_sondeo    # bit de "dato disponible" en 0 -> reintenta

		andi a0, a0, 0xFF

		lw   ra, 0(sp)
		addi sp, sp, 4
		jr   ra
	
	
	
	#Imprime el arreglo BCD por UART como numero legible, sin ceros a la izquierda en la parte entera.
	#ARGS
	#a0 = puntero  arreglo BCD 
	#RET
	mostrar_bcd:
		addi sp, sp, -16
		sw   s0, 12(sp)
		sw   s1, 8(sp)
		sw   s2, 4(sp)
		sw   ra, 0(sp)

		add  s0, a0, zero

		lw   t0, 0(s0)
		beq  t0, zero, mb_sin_signo
			addi a0, zero, 45
			jal  ra, WriteUART
		mb_sin_signo:

		addi s1, zero, 1
		mb_buscar:
			addi t1, zero, 10
			beq  s1, t1, mb_encontrado    # llegamos a las unidades: se imprime si o si
			add  t2, s1, s1
			add  t2, t2, t2
			add  t2, t2, s0
			lw   t3, 0(t2)
			bne  t3, zero, mb_encontrado
			addi s1, s1, 1
			beq  zero, zero, mb_buscar
		mb_encontrado:

		mb_imprimir_ent:
			addi t1, zero, 11
			beq  s1, t1, mb_punto
			add  t2, s1, s1
			add  t2, t2, t2
			add  t2, t2, s0
			lw   t3, 0(t2)
			addi a0, t3, 48
			jal  ra, WriteUART
			addi s1, s1, 1
			beq  zero, zero, mb_imprimir_ent

		mb_punto:
			addi a0, zero, 46
			jal  ra, WriteUART

			addi s2, zero, 12
		mb_imprimir_frac:
			addi t1, zero, 17
			beq  s2, t1, mb_fin
			add  t2, s2, s2
			add  t2, t2, t2
			add  t2, t2, s0
			lw   t3, 0(t2)
			addi a0, t3, 48
			jal  ra, WriteUART
			addi s2, s2, 1
			beq  zero, zero, mb_imprimir_frac

		mb_fin:
			lw   s0, 12(sp)
			lw   s1, 8(sp)
			lw   s2, 4(sp)
			lw   ra, 0(sp)
			addi sp, sp, 16
			jr   ra
	
	#Convierte numeros en CA2 a un arreglo BCD en formato signo[1],int[10],punto[1],float[5]
	#ARGS
	#a0: int procesado
	#a1: posicion arreglo 17 posiciones entrada
	#RET
	#a0: posicion arreglo 17 posiciones salida
    ca2_bcd:				

	addi sp, sp, -24          #separar espacio stack
    sw   s0, 20(sp)
    sw   s1, 16(sp)
    sw   s2, 12(sp)
    sw   s3, 8(sp)
    sw   s4, 4(sp)
    sw   ra, 0(sp)			  #guardar ra por el uso de otras funciones

    add s0, a0, zero
    add s1, a1, zero
    la  s2, cte_div       #cargar arrays
    add s4, s1, zero
                
	sw   zero, 0(s1)
    bge   s0, zero, positivo
	sub   s0, zero, s0
	addi  t5, zero, 1
    sw    t5, 0(s1)
	
    positivo:
		addi  t0, zero, 0       # contador
		addi  t1, zero, 10    
		addi  t6, zero, 1 
		array:
			beq   t1, t0, fin_array   # i == 10
			add   t2, t0, t0          
			add   t2, t2, t2           
			add   t2, t2, s2           

			add   a0, s0, zero           # dividendo
			lw    a1, 0(t2)            # cte_div[i]  divisor
			jal cociente

			add   t4, t6, t6
			add   t4, t4, t4           
			add   t4, t4, s4           
			sw    a0, 0(t4)            # resultado_bcd[i]

			add   a0, s0, zero         # recargar dividendo original
			lw    a1, 0(t2)            # divisor 
			jal residuo
			add   s0, a0, zero

			addi  t0, t0, 1            # i++
			addi  t6, t6, 1
			beq zero, zero, array   

		fin_array:
			addi t5, zero, 46
    		sw   t5, 44(s1)    
			sw zero, 48(s1)     # resultado_bcd[13]  = 0
    		sw zero, 52(s1)     # resultado_bcd[14]  = 0
    		sw zero, 56(s1)     # resultado_bcd[15] = 0
    		sw zero, 60(s1)     # resultado_bcd[16] = 0
    		sw zero, 64(s1)		## resultado_bcd[17] = 0
			
			add  a0, s1, zero
			
			lw     s0, 20(sp)
			lw     s1, 16(sp)
			lw     s2, 12(sp)
			lw     s3, 8(sp)
			lw     s4, 4(sp)
			lw     ra, 0(sp)
			addi sp, sp, 24
			jr ra
	
		
	#Convierte el formato de BCD declarado a un float 
	#ARGS
	#a0: arreglo 17 posiciones entrada
	#RET
	#fa0: float procesado
	bcd_to_float:
		addi sp, sp, -20          #separar espacio stack
		sw   s0, 16(sp)
		sw   s1, 12(sp)
		sw   s2, 8(sp)
		sw   s3, 4(sp)
		sw   ra, 0(sp)
		
		add   s0, a0, zero
		add   s1, zero, 0	
		addi  s3, zero, 0
		addi  t0, zero, 1       # contador       
		addi  t1, zero, 17
		addi  s2, zero, 46
		
		
		int:
			add   t2, t0, t0          
        	add   t2, t2, t2           # 4*i  offset
        	add   t2, t2, s0           
		
			lw    t3, 0(t2)			   #cargar valor del array
			
			beq   t3, s2, fraction
			
			addi  a0, s1, 0
			
			jal mult10
			
			add  s1, a0, t3
			
			addi  t0, t0, 1            # i++
			beq zero, zero, int
		
		fraction:
		
			addi  t0, t0, 1            # i++
			
			beq   t1, t0, fin_int
			add   t2, t0, t0          
        	add   t2, t2, t2           # 4*i  offset
        	add   t2, t2, s0           # base + offset
			
			lw    t3, 0(t2)			   #cargar valor del array
			
			addi  a0, s3, 0
			
			jal mult10
			
			add  s3, a0, t3
			
			beq zero, zero, fraction

	

		fin_int:
				fcvt.s.w  fa0, s1
				fcvt.s.w  fa1, s3
				
				li t0, 100000
				
				fcvt.s.w  ft0, t0
				fdiv.s    fa1, fa1, ft0
				
				fadd.s 	  fa0, fa0, fa1
				
				lw t6, 0(a0)
				beq	t6, zero, pos
				fcvt.s.w ft1, zero     # ft0 = 0.0
				fsub.s   fa0, ft1, fa0 

			pos:
				
				lw   s0, 16(sp)
				lw   s1, 12(sp)
				lw   s2, 8(sp)
				lw   s3, 4(sp)
				lw   ra, 0(sp)
				addi sp, sp, 20
				jr ra


	#Convierte un float al formato de BCD declarado
	#ARGS
	#fa0: float procesado
	#a1: arreglo 17 posiciones entrada	
	#RET
	#a0: posicion arreglo 17 posiciones salida
	float_to_bcd:
		addi sp, sp, -16
		sw   ra, 0(sp)

		# Signo float 
		fmv.w.x fa3, zero
		flt.s t6, fa0, fa3
		sw   t6, 8(sp)

		#  valor absoluto
		beq  t6, zero, es_positivo
		fsgnjn.s fa0, fa0, fa0

	es_positivo:
		# redondea al mas cercano 
		fcvt.w.s t0, fa0
		fcvt.s.w fa1, t0
		flt.s t1, fa0, fa1          # t1 = 1 si el redondeo subio (entero > original)
		sub  t0, t0, t1             # corregir: entero = entero - t1
		sw   t0, 4(sp)

		add  a0, t0, zero
		jal  ra, ca2_bcd            # base arreglo

		#signo (0/1)
		lw   t6, 8(sp)
		sw   t6, 0(a0)

		# Punto decimal 11 ( ASCII)
		addi t4, a0, 44
		addi t5, zero, 46
		sw   t5, 0(t4)

		# Fraccion en 12
		addi a1, a0, 48

		# Fraccion = abs(original) - entero  (queda en [0,1))
		lw   t0, 4(sp)
		fcvt.s.w fa1, t0
		fsub.s fa0, fa0, fa1

		jal  ra, frac_bcd

		lw   ra, 0(sp)
		addi sp, sp, 16
		jr   ra

	frac_bcd:
		addi sp, sp, -16
		sw   ra, 0(sp)

		addi t1, zero, 0
		addi t2, zero, 5

	loop_frac:
		beq  t1, t2, fin_frac

		la   t4, f10
		flw  ft0, 0(t4)
		fmul.s fa0, fa0, ft0

		# Restar 0.499999 (truncamiento)
		la   t4, fhalf
		flw  ft1, 0(t4)
		fsub.s fa2, fa0, ft1

		fcvt.w.s t5, fa2

		# Evitar digitos negativos
		blt  t5, zero, cero_digito
		beq  zero, zero, guardar_digito

	cero_digito:
		addi t5, zero, 0

	guardar_digito:
		sw   t5, 0(a1)
		addi a1, a1, 4

		# Restar digito a la fraccion
		fcvt.s.w fa3, t5
		fsub.s fa0, fa0, fa3

		addi t1, t1, 1
		beq  zero, zero, loop_frac

	fin_frac:
		lw   ra, 0(sp)
		addi sp, sp, 16
		jr   ra

	
	ReadUART: # retorna en a0 caracter entrado
		la t0, ReadAddrUART
		lw t0, 0(t0) # Carga en t0 direccion UART
		lw a0, 0(t0)
		jr ra
	WriteUART: # recibe en a0 caracter a escribir
		la t0, WriteAddrUART
		lw t0, 0(t0) # Carga en t0 direccion UART
		sw a0, 0(t0)
		jr ra
	DELChar: # borra un caracter de la pantalla
		addi sp, sp, -4
		sw ra, 0(sp) # Push ra
		addi a0, zero, 0x8 # caracter retroceso
		jal WriteUART
		addi a0, zero, 0x20 # caracter espacio en blanco
		jal WriteUART
		addi a0, zero, 0x8 # caracter retroceso
		jal WriteUART
		lw ra, 0(sp) # Pop ra
		addi sp, sp, 4
		jr ra
		
		
	#Divide dos numeros
	#ARGS
	#a0: divisor
	#a1: dividendo	
	#RET
	#a0: cociente
	cociente: 
		addi t3, zero, 0 
		for1:
				blt a0, a1, end1
				sub a0, a0, a1
				addi t3, t3, 1 
				beq   zero, zero, for1
		end1:
			add a0, t3, zero
			jr ra
			
	#residuo de una division
	#ARGS
	#a0: divisor
	#a1: dividendo	
	#RET
	#a0: residuo
	residuo: 
		for2:
				blt a0, a1, end2
				sub a0, a0, a1
				beq   zero, zero, for2
		end2:
			add a0, a0, zero
			jr ra

	#multiplica por 10
	#ARGS
	#a0: numero a multiplicar
	#RET
	#a0: a0*10
	mult10:
		add  t4, a0, a0     # t4 = a0*2
   		add  t5, t4, t4     
    	add  t5, t5, t5     # t5 = a0*8
    	add  a0, t5, t4 
		jr ra	
	
		
